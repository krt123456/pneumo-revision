<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ : sauvegarde Google et transfert vers un nouveau téléphone de la progression. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="file" path="pneumo-state.json" />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="pneumo-state.json" />
    </device-transfer>
</data-extraction-rules>
