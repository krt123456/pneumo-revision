<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: Google backup and device transfer of the learning state. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="file" path="fasih-state.json" />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="fasih-state.json" />
    </device-transfer>
</data-extraction-rules>
